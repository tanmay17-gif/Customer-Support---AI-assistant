# ─────────────────────────────────────────────────────────────────────────────
#  CS_Assistant — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini API Key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Admin Bot ──────────────────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram → paste token below
# 2. Get your chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ── Gmail (IMAP — use a dedicated support inbox) ──────────────────────────
# Use a Gmail App Password, NOT your real Gmail password.
# Generate one: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=your_support_inbox@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── App Settings (leave blank to use defaults) ────────────────────────────
DATABASE_URL=sqlite:///./data/cs_assistant.db
CHROMA_PERSIST_DIR=./data/chroma_db
POLICY_DOC_PATH=./data/policy/refund_policy.txt
INVOICES_DIR=./data/invoices
LOGS_DIR=./data/logs

# ── Server ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
